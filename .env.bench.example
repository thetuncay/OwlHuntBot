# OwlHunt benchmark — sahte değerler. Production .env kopyalama.
NODE_ENV=test
DISCORD_TOKEN=bench-invalid-token
CLIENT_ID=0
GUILD_ID=0
MAIN_GUILD_ID=0
ADMIN_USER_IDS=bench-admin
DATABASE_URL=postgresql://owlhunt_bench:owlhunt_bench@127.0.0.1:5434/owlhunt_bench?connection_limit=16
DIRECT_DATABASE_URL=postgresql://owlhunt_bench:owlhunt_bench@127.0.0.1:5434/owlhunt_bench
USE_PGBOUNCER=0
REDIS_URL=redis://127.0.0.1:6390
BOT_DB_POOL_LIMIT=8
WORKER_DB_POOL_LIMIT=8
DB_QUEUE_CONCURRENCY=8
MAX_CONCURRENT_COMMANDS=32
PERF_METRICS=1
OPS_PANEL_ENABLED=0
ANTICHEAT_ENABLED=0
SIM_PVP_SKIP_ANIM=0
