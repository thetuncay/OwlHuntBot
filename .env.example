# ============================================================
# OwlHuntBot — Ortam Degiskenleri Ornegi
# Kopyala: cp .env.example .env
# ============================================================

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_client_id
# Ana sunucu (Owl Hunt Discord) — /admin guild deploy, liderboard rolleri
# MAIN_GUILD_ID=1494717650603999373
# Eski uyumluluk (opsiyonel; admin deploy artık MAIN_GUILD_ID kullanır):
GUILD_ID=1494717650603999373
# Resmi topluluk davet linki (kayit / yardim)
OFFICIAL_DISCORD_INVITE_URL=https://discord.gg/5yQxgQDRHu
# Admin Discord kullanici ID'leri (virgulle ayrilmis) — production'da ZORUNLU
ADMIN_USER_IDS=your_discord_user_id

# Controlled public launch
# Pilot: 50 | 100 sunucu profili: docs/CAPACITY_100_GUILDS.md
MAX_GUILDS=100
# BAN_CACHE_TTL_MS=300000
# HEALTH_QUEUE_FAILED_MAX=50

# Ortam: development | production | test
NODE_ENV=production

# PostgreSQL — PgBouncer uzerinden (transaction pooling)
# Sifrede @ varsa URL'de %40 kullan (ornek: sifre@123 -> sifre%40123)
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_PASSWORD_URLENC=your_url_encoded_password
DATABASE_URL="postgresql://postgres:YOUR_URLENC_PASSWORD@localhost:6432/owlhuntbot"
USE_PGBOUNCER=1
DIRECT_DATABASE_URL="postgresql://postgres:YOUR_URLENC_PASSWORD@127.0.0.1:5432/owlhuntbot"

# Redis (hot state + BullMQ) — Docker port 6380, sifre zorunlu
REDIS_PASSWORD=your_strong_redis_password
REDIS_PASSWORD_URLENC=your_url_encoded_password
REDIS_URL=redis://:YOUR_URLENC_PASSWORD@127.0.0.1:6380

# DB yedek — bulut append-only (asla uzaktan silinmez). Kurulum: docs/CLOUD-BACKUP.md
BACKUP_ENABLED=1
BACKUP_DIR=/var/backups/owlhuntbot
# rclone remote (ornek: b2:owlhunt-backups/owlhunt-db veya gdrive:OwlHuntBot-DB)
BACKUP_RCLONE_REMOTE=
# BACKUP_RCLONE_REMOTE_SECONDARY=
BACKUP_REQUIRE_CLOUD=1
BACKUP_LOCAL_RETENTION_DAYS=2
BACKUP_INCLUDE_REDIS=1
BACKUP_VERIFY=1
BACKUP_SYNC_RCLONE_CONFIG=1
# Google Drive OAuth token (tek seferlik kurulum — scripts/setup-gdrive-backup.sh)
# GOOGLE_DRIVE_RCLONE_TOKEN=

# Guvenlik: VDS'te bir kez calistir → bash scripts/security-hardening.sh
# (UFW, fail2ban, Docker DOCKER-USER, PostgreSQL log_connections)

# Process modu (PM2 ecosystem otomatik ayarlar)
# RUN_MODE=bot
# RUN_MODE=worker

# DB pool (appendPoolParams ile URL'e eklenir)
BOT_DB_POOL_LIMIT=8
WORKER_DB_POOL_LIMIT=25
DB_POOL_TIMEOUT=10

# Yogunluk korumasi: ayni anda islenecek max komut (global) — 50 guild: 40, 100: 80
MAX_CONCURRENT_COMMANDS=70
BOT_DB_POOL_LIMIT=12
WORKER_DB_POOL_LIMIT=32
HEALTH_QUEUE_FAILED_MAX=100
# Koruma sayaci TTL (saniye)
COMMAND_GATE_TTL_SECONDS=15
# Anti-spam: pencerede max komut; asimda SPAM_MUTE_SECONDS mute (4 mute ~ 1 uyari, 3 uyari ~ ban)
COMMAND_RATE_LIMIT_TOKENS=8
COMMAND_RATE_LIMIT_WINDOW_SECONDS=12
SPAM_MUTE_SECONDS=20
SPAM_MUTE_ESCALATION_SECONDS=20,45,90,180,300
MOD_SPAM_STRIKES_FOR_WARN=4
MOD_WARN_THRESHOLD=3
MOD_SPAM_STRIKE_WINDOW_SECONDS=14400
# v2.1 Abuse breaker (flood/makro — normal akista mute/ban yok)
ABUSE_RAW_REQUESTS=40
ABUSE_SAME_COMMAND=20
ABUSE_WINDOW_SECONDS=10
FLOW_SUPPRESSION_MIN_INTERVAL_MS=15000
FLOW_INTENT_TTL_SECONDS=1800
# Anticheat rollout flags (Faz 1)
ANTICHEAT_ENABLED=1
ANTICHEAT_RATE_LIMIT_ENFORCE=1
ANTICHEAT_BEHAVIOR_LOG=1
ANTICHEAT_TRUST_SCORE=1
ANTICHEAT_CAPTCHA_ENFORCE=0
# 1 yapınca trustScore <= 40 iken komutlar emoji doğrulaması olmadan çalışmaz (OwO tarzı bot koruması)
ANTICHEAT_THROTTLE_ENFORCE=0
ANTICHEAT_PUNISHMENT_ENFORCE=0
ANTICHEAT_RETENTION_ENABLED=1
# BullMQ worker paralelligi (DB write throughput)
DB_QUEUE_CONCURRENCY=80
# Oyuncu okuma cache (saniye) — stats/cash/hunt
PLAYER_CACHE_TTL_S=180
# Kayit kontrolu cache (saniye) — ensureRegistered
REG_CACHE_TTL_S=300
# Redis-first persist debounce (ms)
PERSIST_DEBOUNCE_MS=2500

# Saglik kontrolu portu (shard manager HTTP /health + yerel ops panel)
HEALTH_PORT=3010
# Ops web paneli — ayri PM2 process (owlhuntbot-ops-panel), sadece localhost
# OPS_PANEL_PORT=3011
# OPS_PANEL_ENABLED=1
# /admin — HTTP Basic Auth (production'da zorunlu)
# DISCORD_CLIENT_SECRET=...   # Developer Portal → OAuth2 (web login)
# DISCORD_PUBLIC_KEY=...      # Developer Portal → General → Public Key (Interactions URL doğrulama)
# WEB_PUBLIC_URL=https://owlhunt.thetuncay.com   # Ban itiraz bağlantıları için zorunlu önerilir
# Developer Portal URL'leri (WEB_PUBLIC_URL altında):
#   Interactions Endpoint:  /api/interactions
#   Linked Roles Verify:    /verify-user
#   Terms of Service:       /terms-of-service
#   Privacy Policy:         /privacy-policy
# Anket tamamlama duyurusu (Discord kanal mesaji)
# FEEDBACK_ANNOUNCE_ENABLED=1
# FEEDBACK_ANNOUNCE_GUILD_ID=...       # varsayilan: GUILD_ID
# FEEDBACK_ANNOUNCE_CHANNEL_ID=...     # bos ise ilk owl-only kanal
# WEB_OAUTH_REDIRECT_URI=https://owlhunt.thetuncay.com/api/auth/discord/redirect
# LINKED_ROLE_OAUTH_REDIRECT_URI=https://owlhunt.thetuncay.com/api/auth/discord/linked-role/callback
# WEB_OAUTH_SCOPES=identify email
# WEB_SESSION_SECRET=...        # openssl rand -base64 32 — ZORUNLU (bot token ile imzalama oturum dusurur)
# PUBLIC_SITE_ENABLED=1
# PUBLIC_BOT_NAME=OwlHuntBot
# SUPPORT_SERVER_URL=https://discord.gg/5yQxgQDRHu
# DISCORD_INVITE_PERMISSIONS=4504115023833104

# Phase 1.5 — pilot observability (rolling Redis metrics; default ON in production)
# OPS_ANALYTICS=1
# COMMAND_TELEMETRY_PG=0   # PG CommandEvent batch (default OFF in production)

# Performans olcumu (OPS_ANALYTICS acikken production'da varsayilan acik)
# PERF_METRICS=0         # kapatmak icin
# PERF_SLOW_MS=2000       # bu sureyi asan komutlar [Perf] SLOW olarak loglanir
# PERF_SUMMARY_INTERVAL_SECONDS=60
# Bot duel animasyonunu atla (latency test / dusuk gecikme)
# SIM_PVP_SKIP_ANIM=1
# Hunt kritik yol profili (pgReads, executionDurationMs — ops:hunt:hotpath:v1)
# HUNT_HOTPATH_PROFILE=1
# Rehydrate script paralelligi (scripts/rehydrate-all-players.ts)
# REHYDRATE_CONCURRENCY=20

# Health / readiness thresholds
# HEALTH_QUEUE_FAILED_MAX=50

# Liderboard Discord rolleri (opsiyonel — yoksa /admin ile otomatik olusturulur)
ROLE_POWER_1=
ROLE_POWER_2=
ROLE_HUNT_1=
ROLE_HUNT_2=
ROLE_HUNT_3=
ROLE_RELIC_1=
ROLE_RELIC_2=
ROLE_ARENA_1=
ROLE_ARENA_2=
ROLE_WEALTH_1=
ROLE_WEALTH_2=

# Migration scriptleri icin (opsiyonel)
MONGODB_URL=mongodb://localhost:27017/baykusbot

