# Bağımlılıklar
node_modules/

# Build çıktısı
dist/

# Ortam değişkenleri (asla commit edilmemeli)
.env
.env.local
.env.*.local
.env.bench
!.env.example
!.env.bench.example

# PostgreSQL veri dosyaları
.pgdata/
*.pgdata/
pg_log/
.pglog.txt

# PM2 logları (içerik commit edilmez, klasör yapısı .gitkeep ile korunur)
logs/*
!logs/.gitkeep

# Yedekler
backups/
backup_*/
*.dump
*.sql.gz

# Hassas dosyalar
*.pem
*.key
credentials.json
*.p12

# OS dosyaları
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Cursor MCP — yerel komut/bağlantı; commit edilmez (.cursor/mcp.json.example şablon)
.cursor/mcp.json

# Bench ölçüm JSON'ları (yerel); .gitkeep kalsın
benchmarks/results/*.json

# TypeScript cache
*.tsbuildinfo

# Feedback upload storage
data/feedback-uploads/
data/copy-overrides.json

baykusbot@*
pnpm
tsx
server_log.txt

# SSH oturum transkripti — canlı bot token'ı içeriyor, asla commit edilmez
OwlHunt-VDS-SSH-chatler.md

# Arşiv veri setleri (üçüncü taraf bot mesajları — kaynak analiz)
metala-data/
exports2/
datalar/command_classification-*.json
datalar/player_behavior-*.json
datalar/reward_expectation-*.json
datalar/sequence_prediction-*.json
